{
  "name": "@lc-play/lg-webos",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:tv": "tsc -b && vite build --config vite.tv.config.ts",
    "package:tv": "pnpm build:tv && ares-package --no-minify dist-tv --outdir artifacts",
    "lint": "oxlint",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "test": "node --test tests/*.test.mjs"
  },
  "dependencies": {
    "@lc-play/contracts": "workspace:*",
    "hls.js": "1.7.3",
    "lucide-react": "latest",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "oxlint": "^1.81.0",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
